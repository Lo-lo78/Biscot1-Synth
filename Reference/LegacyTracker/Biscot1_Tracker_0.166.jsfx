      song_finish_or_restart();
      !status_stop_pending ? song_schedule_all(horizon);
      chain_guard+=1;
    );
    song_update_lane_finishes();
  ) : (
    while (play_active && next_step_time <= horizon) (
      sps = samples_per_step();
      schedule_step(current_step, next_step_time);
      current_step += 1;
      current_step >= pattern_length ? (
        repeat_index += 1;
        repeat_index < pattern_repeat ? (
          repeat_speed = midi_mode ? max(0.25,min(16,gmem[active_midi_header_base+5+repeat_index]>0?gmem[active_midi_header_base+5+repeat_index]:1)) : max(0.25, min(16, gmem[LUA_BASE + 8 + repeat_index] > 0 ? gmem[LUA_BASE + 8 + repeat_index] : slider4));
          repeat_transpose = midi_mode ? clampi(gmem[active_midi_header_base+5+pattern_repeat+repeat_index],-96,96) : clampi(gmem[REPEAT_TRANSPOSE_BASE+repeat_index],-96,96);
          current_step = 0;
        ) : finish_pattern_at(next_step_time + sps);
      );
      next_step_time += sps;
    );
  );
);

@sample
// The core consumes all Pattern and Song events from the shared GMEM queue at
// their exact target sample. FX order is irrelevant.

@gfx 620 100
gfx_set(1,1,1,1);
gfx_x=10; gfx_y=10; gfx_drawstr("Biscot1 Tracker: direct GMEM, three independent Song operators.");
gfx_x=10; gfx_y=30; gfx_drawstr(play_active ? "Pattern playing" : "Stopped");
gfx_x=10; gfx_y=50; gfx_drawstr("Step "); gfx_drawnumber(current_step,0);
